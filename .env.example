# RAT environment configuration.
# Copy to `.env` at the repository root, or export the variables directly.
# Every variable has a sensible default — a `.env` file is optional.

# Port the Express API listens on.
API_PORT=4000

# Directory (relative to the repository root, or absolute) where uploaded zips,
# cloned repositories and the SQLite database are stored.
RAT_STORAGE_DIR=./storage

# Base URL of the API used by the Next.js web app.
# Note: for the web app this must be set at *build time* (NEXT_PUBLIC_* vars are
# inlined). Put it in `apps/web/.env.local` instead of this file if you change it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Maximum accepted size, in MB, of an uploaded repository zip.
MAX_UPLOAD_MB=512

# Timeout, in milliseconds, for a `git clone` of a remote repository.
# Default: 30 minutes.
CLONE_TIMEOUT_MS=1800000
